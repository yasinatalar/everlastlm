{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm --filter @everlast/contracts build && pnpm --filter @everlast/api build",
  "outputDirectory": "dist",
  "regions": ["fra1"],
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 300,
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index.js" }]
}
