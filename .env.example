# ---------------------------------------------------------------------------
# Everlast — copy to apps/api/.env and apps/web/.env.local
#
# `pnpm db:start` prints the local Supabase values; paste them below.
# Never commit a filled-in copy: .env and .env.local are gitignored.
# ---------------------------------------------------------------------------

# === apps/api/.env =========================================================

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# Comma-separated CORS allowlist. No wildcards.
WEB_ORIGINS=http://localhost:3000
# Production: WEB_ORIGINS=https://everlastlm.com,https://www.everlastlm.com

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Local Supabase signs with HS256 and this shared secret. Leave EMPTY for a
# hosted project that publishes a JWKS — the verifier discovers the keys.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Chat, summaries and studio generation.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_UTILITY_MODEL=claude-haiku-4-5

# Embeddings. Must match the vector width in the migration (1024).
#
# Two places issue keys for the same Voyage models, and each rejects the
# other's with a plain 401:
#   pa-…  from voyageai.com          -> https://api.voyageai.com/v1
#   al-…  from MongoDB Atlas         -> https://ai.mongodb.com/v1
#        (Atlas → AI Model APIs → Model API Keys; MongoDB owns Voyage)
# The host is chosen from the key prefix, so normally leave VOYAGE_BASE_URL
# unset. Set it only for a proxy or an unrecognised prefix.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4
VOYAGE_DIMENSIONS=1024
VOYAGE_BASE_URL=
# Requests per minute we allow ourselves. 3 is the ceiling on a Voyage/Atlas
# account with NO payment method — the cause of documents failing to ingest
# with a 429. Raise it once billing is configured or ingestion is needlessly
# slow (paid tiers start around 300).
VOYAGE_MAX_RPM=3

# Audio overviews. `none` stores the script without synthesising speech.
TTS_PROVIDER=none
ELEVENLABS_API_KEY=
# Concurrent TTS requests. Free tier allows 2; raise it on a paid plan.
ELEVENLABS_MAX_CONCURRENCY=2
# Must be a "premade" voice: community Voice Library voices are paid-only over
# the API, so a free key gets 402 on every turn. `GET /v2/voices` lists yours.
ELEVENLABS_VOICE_HOST_A=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_VOICE_HOST_B=cjVigY5qzO86Huf0OWal

RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_LIMIT=120
RATE_LIMIT_AI_LIMIT=20

MAX_UPLOAD_BYTES=52428800
# Only ever true for local development — it disables the SSRF guard.
ALLOW_PRIVATE_NETWORK_FETCH=false

# === apps/web/.env.local ===================================================

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:3001
