{
  "name": "everlast",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @everlast/contracts build && pnpm --filter @everlast/api build && pnpm --filter @everlast/web build",
    "dev": "pnpm --parallel --filter @everlast/api --filter @everlast/web dev",
    "dev:api": "pnpm --filter @everlast/api dev",
    "dev:web": "pnpm --filter @everlast/web dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "email:build": "node scripts/build-email-templates.mjs",
    "email:push": "node scripts/push-email-templates.mjs",
    "check:providers": "node scripts/check-providers.mjs",
    "check:esm": "node scripts/check-esm.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,css}\"",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff",
    "db:push": "supabase db push",
    "db:schema": "bash -c '{ echo \"-- Everlast \u2014 complete schema, generated from supabase/migrations/\"; echo \"-- Regenerate with: pnpm db:schema\"; echo; for f in supabase/migrations/*.sql; do echo \"-- === $(basename $f) ===\"; cat \"$f\"; echo; done; } > supabase/schema.sql'"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  }
}
